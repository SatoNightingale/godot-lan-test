; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Prueba LAN"
config/version="0.4.1"
run/main_scene="uid://7c5qi7ecxocq"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

PatchSystem="*uid://7w37r2vsmrjn"
Configurations="*uid://l5c4wgitfdam"
ItemManager="*uid://dre4woh5meh76"
Network="*uid://c8nrfbdxgge2b"
ConsoleLogger="*uid://b6sotjiruqdpn"
RpcAwait="*uid://b0dicnumx46f8"
TooltipManager="*uid://tt23xstuvqe8"

[display]

window/size/viewport_width=853
window/size/viewport_height=480
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/better-tile-editor/plugin.cfg", "res://addons/rpc-await/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://android/": "gray",
"res://build/": "gray",
"res://common/": "purple",
